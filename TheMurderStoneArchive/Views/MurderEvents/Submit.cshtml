@model TheMurderStoneArchive.Models.MurderEvent
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Submit a Murder Stone";
}

<div class="container mt-4">
    <h2>Submit a Stone or Legend</h2>
    <p class="text-muted">Know of a confirmed site, local folklore, pudding stone, or boundary marker? Submit it here for review.</p>
    <hr />
    <div class="row">
        <div class="col-md-7">
            <form id="submitForm" asp-action="Submit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="control-label">Stone / Event Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g., The Devil's Punchbowl Stone" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="control-label">Category</label>
                    <select asp-for="Category" class="form-control" asp-items="Html.GetEnumSelectList<TheMurderStoneArchive.Models.StoneCategory>()"></select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Year" class="control-label">Approximate Year</label>
                    <input asp-for="Year" class="form-control" placeholder="e.g., 1786" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location.Name" class="control-label">Location Name / Description</label>
                    <input asp-for="Location.Name" class="form-control" placeholder="e.g., Near Thursley Common" />
                    <span asp-validation-for="Location.Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location.Latitude" class="control-label">Latitude</label>
                        <input asp-for="Location.Latitude" class="form-control" placeholder="51.1234" />
                        <span asp-validation-for="Location.Latitude" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location.Longitude" class="control-label">Longitude</label>
                        <input asp-for="Location.Longitude" class="form-control" placeholder="-0.7123" />
                        <span asp-validation-for="Location.Longitude" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="control-label">The Story (Fact or Fiction)</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Describe the history, legend, or local oral tradition..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsProtected" class="form-check-input" />
                    <label asp-for="IsProtected" class="form-check-label">Is this a registered Historic England listed monument?</label>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="IsLost" class="form-check-input" />
                    <label asp-for="IsLost" class="form-check-label">Is this stone currently lost, destroyed, or missing?</label>
                </div>

                <div class="mb-3">
                    <label class="control-label">Photos (optional, up to 10)</label>
                    <input type="file" name="Photos" id="photosInput" class="form-control" multiple accept="image/*" />
                    <small class="form-text text-muted">Allowed: JPG, PNG, GIF, WEBP. Max 25 MB per file.</small>
                    <div class="text-danger" id="photosError"></div>
                    <div id="photoPreviewContainer" class="mt-2 d-flex flex-wrap gap-2"></div>
                </div>

                <div class="mb-3">
                    <label class="control-label">YouTube video links (optional, up to 3)</label>
                    <input type="url" name="YouTubeLinks" class="form-control mb-2" placeholder="https://youtube.com/watch?v=..." />
                    <input type="url" name="YouTubeLinks" class="form-control mb-2" placeholder="https://youtube.com/watch?v=..." />
                    <input type="url" name="YouTubeLinks" class="form-control" placeholder="https://youtube.com/watch?v=..." />
                    <small class="form-text text-muted">Provide full YouTube URLs (optional).</small>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="ConfirmRightsAndTerms" class="form-check-input" />
                        <label asp-for="ConfirmRightsAndTerms" class="form-check-label">I confirm I own the rights to any uploaded images (or have permission) and I accept the <a asp-controller="Home" asp-action="Terms">Terms</a> and <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.</label>
                    </div>
                    <span asp-validation-for="ConfirmRightsAndTerms" class="text-danger"></span>
                </div>

                <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response" />

                <button type="submit" class="btn btn-primary">Submit for Review</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function(){
            const input = document.getElementById('photosInput');
            const err = document.getElementById('photosError');
            const preview = document.getElementById('photoPreviewContainer');
            const MAX_FILES = 10;
            const MAX_SIZE = 25 * 1024 * 1024; // 25MB
            const dt = new DataTransfer();

            function createPreviewForFile(file, uid) {
                const url = URL.createObjectURL(file);
                const wrapper = document.createElement('div');
                wrapper.className = 'border p-1 bg-light';
                wrapper.style.width = '120px';
                wrapper.style.position = 'relative';
                wrapper.dataset.uid = uid;

                const img = document.createElement('img');
                img.src = url;
                img.style.width = '100%';
                img.style.height = '80px';
                img.style.objectFit = 'cover';
                wrapper.appendChild(img);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm btn-danger';
                btn.style.position = 'absolute';
                btn.style.top = '4px';
                btn.style.right = '4px';
                btn.textContent = '✕';
                btn.addEventListener('click', function(){
                    // remove from DataTransfer
                    for (let i = 0; i < dt.items.length; i++) {
                        const it = dt.items[i].getAsFile();
                        if (!it) continue;
                        if (it.name === file.name && it.size === file.size && it.type === file.type) {
                            dt.items.remove(i);
                            break;
                        }
                    }
                    input.files = dt.files;
                    wrapper.remove();
                    err.textContent = '';
                });
                wrapper.appendChild(btn);

                return wrapper;
            }

            input && input.addEventListener('change', function(){
                err.textContent = '';
                const files = Array.from(this.files || []);
                if ((dt.files.length + files.length) > MAX_FILES) {
                    err.textContent = `You can upload up to ${MAX_FILES} photos.`;
                    return;
                }
                for (let f of files) {
                    if (f.size > MAX_SIZE) {
                        err.textContent = `${f.name} exceeds the ${MAX_SIZE/1024/1024} MB limit.`;
                        return;
                    }
                    if (!f.type.startsWith('image/')) {
                        err.textContent = `${f.name} is not an image file.`;
                        return;
                    }
                }

                for (let f of files) {
                    const uid = Date.now().toString(36) + Math.random().toString(36).slice(2,8);
                    dt.items.add(f);
                    const node = createPreviewForFile(f, uid);
                    preview.appendChild(node);
                }
                input.files = dt.files;
            });
        })();
    </script>
    <script src="https://www.google.com/recaptcha/api.js?render=@Configuration["ReCaptcha:SiteKey"]" async defer></script>
    <script>
        (function(){
            var form = document.getElementById('submitForm');
            if (!form) return;
            form.addEventListener('submit', function(e){
                e.preventDefault();
                grecaptcha.ready(function(){
                    grecaptcha.execute('@Configuration["ReCaptcha:SiteKey"]', {action: 'submit'}).then(function(token){
                        var el = document.getElementById('g-recaptcha-response');
                        if (!el) { el = document.createElement('input'); el.type='hidden'; el.name='g-recaptcha-response'; el.id='g-recaptcha-response'; form.appendChild(el); }
                        el.value = token;
                        form.submit();
                    });
                });
            });
        })();
    </script>
}