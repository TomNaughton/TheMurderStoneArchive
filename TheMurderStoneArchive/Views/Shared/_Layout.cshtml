@{
    // 1. Grab the current URL path
    var currentUrl = ViewContext.HttpContext.Request.Path.Value ?? "";
    
    // 2. Check if we are on either API page
    bool isApi = currentUrl.StartsWith("/API/", StringComparison.OrdinalIgnoreCase);
    
    // 3. Determine if the parent menu should be open
    bool isApiMenuExpanded = isApi;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />
    <title>@ViewData["Title"] - The Murder Stone Archive</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Merriweather:wght@300;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheMurderStoneArchive.styles.css" asp-append-version="true" />
</head>
<body>

    @* Mobile top bar (hidden on lg+) *@
    <div class="mobile-topbar d-lg-none">
        <button class="sidebar-toggle" aria-label="Open navigation" onclick="toggleSidebar()">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        <a class="mobile-topbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.svg" alt="The Murder Stone Archive" class="site-logo" />
            <span class="fw-bold">Murder Stone Archive</span>
        </a>
        <div style="width:34px" aria-hidden="true"></div>
    </div>

    @* Overlay — tapping it closes the sidebar on mobile *@
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    @* App shell: sidebar + content side by side on desktop *@
    <div class="app-shell">

        <aside class="app-sidebar" id="appSidebar">

            <div class="sidebar-brand">
                <a class="d-flex align-items-center gap-2 text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="" class="site-logo" aria-hidden="true" />
                    <span class="sidebar-brand-text">Murder Stone Archive</span>
                </a>
            </div>

            <div class="sidebar-search">
                <form role="search" asp-controller="MurderEvents" asp-action="Index" method="get">
                    <label for="sidebarSearch" class="visually-hidden">Search</label>
                    <input id="sidebarSearch" name="searchTerm" class="form-control form-control-sm"
                           type="search" placeholder="Search archive…" aria-label="Search the archive" />
                </form>
            </div>

            <nav class="sidebar-nav" aria-label="Main navigation">

                <div class="sidebar-section-label">Discover</div>
                <a class="sidebar-link" asp-controller="MurderEvents" asp-action="Index">
                    <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    Browse Archive
                </a>

                <div class="sidebar-section-label">Get involved</div>
                <a class="sidebar-link" asp-controller="MurderEvents" asp-action="Submit">
                    <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    Submit a stone
                </a>
                <a class="sidebar-link" asp-controller="Home" asp-action="Campaign" data-cta="sidebar-campaign">
                    <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                    Support the Archive
                </a>

                <div class="sidebar-section-label">Resources</div>
                <a class="sidebar-link" asp-controller="Home" asp-action="ResearchPack" data-cta="sidebar-researchpack">
                    <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Research Pack
                </a>
                <a class="d-flex justify-content-between align-items-center text-decoration-none text-white me-3 @(isApiMenuExpanded ? "" : "collapsed")" data-bs-toggle="collapse" href="#apiSubMenu" role="button" aria-expanded="@(isApiMenuExpanded ? "true" : "false")" aria-controls="apiSubMenu">
                    <span class="sidebar-link-noninteractive d-flex align-items-center gap-2">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                        API
                    </span>
                    <svg class="sidebar-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
                </a>
                <div class="collapse ps-3 @(isApiMenuExpanded ? "show" : "")" id="apiSubMenu">
                    <a class="sidebar-link fw-bold @(currentUrl.Contains("API/Premium", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="API" asp-action="Premium" data-cta="sidebar-api-premium" style="color:gold">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                        Premium Access
                    </a>
                    <hr class="text-white mt-1 mb-1" style="border: none; height: 1px; color: white; background-color: white;"/>
                    <a class="sidebar-link @(currentUrl.Contains("API/QuickStart", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="API" asp-action="QuickStart" data-cta="sidebar-api-quickstart">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
                        Quick Start
                    </a>    
                    <a class="sidebar-link @(currentUrl.Contains("API/Pricing", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="API" asp-action="Pricing" data-cta="sidebar-api-pricing">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01" /></svg>
                        Pricing & Tiers
                    </a>
                    <a class="sidebar-link @(currentUrl.Contains("API/Reference", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="API" asp-action="Reference" data-cta="sidebar-api-reference">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM14 3.5L18.5 8H14V3.5zM8 12h8v2H8v-2zm0 4h8v2H8v-2z" /></svg>
                        API Reference
                    </a>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="sidebar-link @(currentUrl.Contains("API/MyKeys", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-controller="API" asp-action="MyKeys">
                            <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                            My Keys
                        </a>
                    }
                </div>
                <a class="sidebar-link" asp-controller="Home" asp-action="Funding" data-cta="sidebar-funding">
                    <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Funding
                </a>

                @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <div class="sidebar-section-label">Admin</div>
                    <a class="sidebar-link" asp-controller="Home" asp-action="Analytics">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        Analytics
                    </a>
                    <a class="sidebar-link" asp-controller="MurderEvents" asp-action="Pending">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Pending submissions
                        @await Component.InvokeAsync("PendingSubmissionsCount")
                    </a>
                    <a class="sidebar-link" asp-controller="Home" asp-action="CampaignAdmin">
                        <svg class="sidebar-icon" viewBox="0 0 24 24"><path d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        Campaign &amp; donations
                    </a>
                }

            </nav>

            <div class="sidebar-footer">
                <partial name="_LoginPartial" />
            </div>

        </aside>

        <div class="app-content">
            <div class="content-card">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <footer class="app-footer">
                <div class="d-flex flex-wrap gap-3 mb-1">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a asp-controller="Home" asp-action="Terms">Terms</a>
                    <a asp-controller="Home" asp-action="DMCA">DMCA</a>
                </div>
                <div>&copy; 2026 - The Murder Stone Archive</div>
            </footer>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById('appSidebar');
            var overlay = document.querySelector('.sidebar-overlay');
            var open = sidebar.classList.toggle('is-open');
            overlay.classList.toggle('is-visible', open);
            document.body.classList.toggle('sidebar-open', open);
        }

        (function () {
            var path = location.pathname.replace(/\/$/, '') || '/';
            var bestMatch = null;
            var bestLength = -1;

            document.querySelectorAll('.sidebar-link').forEach(function (a) {
                var href = a.getAttribute('href');
                if (!href) return;
                
                var norm = href.replace(/\/$/, '') || '/';
                
                // 1. Check for exact match OR sub-folder match (ensuring it's a full segment)
                if (path === norm || (norm !== '/' && path.startsWith(norm + '/'))) {
                    // 2. If multiple links match, pick the most specific (longest) one
                    if (norm.length > bestLength) {
                        bestLength = norm.length;
                        bestMatch = a;
                    }
                }
            });

            // Apply the active class to the winner
            if (bestMatch) {
                bestMatch.classList.add('active');
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
