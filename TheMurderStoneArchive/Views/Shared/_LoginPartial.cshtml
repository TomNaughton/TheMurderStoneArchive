@using Microsoft.AspNetCore.Identity
@using TheMurderStoneArchive.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var displayName = UserManager.GetUserName(User) ?? "Account";
    <div class="sidebar-account">
        <div class="sidebar-account-user pb-2" title="@displayName">@displayName</div>
        <a class="sidebar-link" asp-area="Identity" asp-page="/Account/Manage/Index">
            <svg class="sidebar-icon" viewBox="0 0 24 24">
                <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Manage account
        </a>
        <form asp-area="Identity" asp-page="/Account/Logout" method="post"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="sidebar-link sidebar-link-btn w-100 text-start">
                <svg class="sidebar-icon" viewBox="0 0 24 24">
                    <path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                Log out
            </button>
        </form>
    </div>
}
else
{
    <div class="sidebar-account">
        <a class="sidebar-link" asp-area="Identity" asp-page="/Account/Login">
            <svg class="sidebar-icon" viewBox="0 0 24 24">
                <path d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
            </svg>
            Log in
        </a>
        <a class="sidebar-link" asp-area="Identity" asp-page="/Account/Register">
            <svg class="sidebar-icon" viewBox="0 0 24 24">
                <path d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            Register
        </a>
    </div>
}
