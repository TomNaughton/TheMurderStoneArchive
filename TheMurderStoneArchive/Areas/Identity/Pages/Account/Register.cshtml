@page
@model TheMurderStoneArchive.Areas.Identity.Pages.Account.RegisterModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="mb-3">Create an account</h2>
        <p class="muted">Register to submit stones and track your contributions.</p>

        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            @if (TempData["DebugErrors"] != null)
            {
                <div class="alert alert-danger mt-2" role="alert">
                    <strong>Registration debug:</strong>
                    <pre>@TempData["DebugErrors"]</pre>
                </div>
            }
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-page="/Account/Login">Already have an account? Sign in</a>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
