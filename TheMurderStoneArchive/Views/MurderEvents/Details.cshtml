@model TheMurderStoneArchive.Models.MurderEvent

<div class="container mt-4">
    @await Html.PartialAsync("_Infobox", Model)

    <h2>@Model.Title</h2>
    <p class="text-muted small">@Model.Year &middot; @Model.Location?.Name</p>

    <div class="mb-3">
        <h3>Description</h3>
        <p>@Model.Description</p>
    </div>

    <div class="fact">
        <strong>Note:</strong> Entries are drawn from historical records and community submissions. Where possible, sources are indicated on each page.
    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
