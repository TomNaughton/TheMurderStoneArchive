@model TheMurderStoneArchive.Models.CampaignViewModel
@{
    ViewData["Title"] = "Campaign";
}

<div class="mx-auto" style="max-width:860px;">
    <div class="card-body">
        <h1 class="card-title">@Model.Name</h1>
        <p class="card-text">@Model.Description</p>

        @if (TempData["CampaignError"] is string campaignError)
        {
            <div class="alert alert-danger" role="alert">@campaignError</div>
        }

        <div class="alert alert-info" role="status">
            <strong>Progress:</strong> £@Model.RaisedAmountGbp.ToString("0.00") raised of £@Model.TargetAmountGbp.ToString("0.00") target (@Model.ProgressPercentage.ToString("0.##")%).
        </div>

        @if (Model.EndsAtUtc.HasValue)
        {
            <p class="small text-muted">Campaign end date: @Model.EndsAtUtc.Value.ToString("yyyy-MM-dd") UTC</p>
        }

        <div class="mb-4">
            <div class="progress" style="height: 22px;">
                <div class="progress-bar" role="progressbar" style="width: @Model.ProgressPercentage%;" aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                    @Model.ProgressPercentage.ToString("0.##")%
                </div>
            </div>
        </div>

        @if (Model.UsePatreon)
        {
            <p class="mb-2">Support through Patreon one-time purchase. You will be redirected to the Patreon checkout page.</p>

            @if (!string.IsNullOrWhiteSpace(Model.PatreonCampaignUrl))
            {
                <a class="btn btn-theme mb-4" href="@Model.PatreonCampaignUrl" rel="noopener noreferrer" data-cta="campaign-donate-patreon">Buy on Patreon</a>
            }
            else
            {
                <div class="alert alert-warning mb-4" role="alert">Patreon is enabled but the campaign URL is not configured yet.</div>
            }
        }
        else if (Model.UseFourthwall)
        {
            @if (!string.IsNullOrWhiteSpace(Model.FourthwallOneTimePaymentUrl))
            {
                <a class="btn btn-theme mb-4" href="@Model.FourthwallOneTimePaymentUrl" rel="noopener noreferrer" data-cta="campaign-donate-fourthwall">Donate</a>
            }
            else
            {
                <div class="alert alert-warning mb-4" role="alert">Fourthwall is enabled but the payment URL is not configured yet.</div>
            }
        }
        else
        {
            <p class="mb-2">Pay securely on-site via Stripe Checkout (Apple Pay / Google Pay supported where available).</p>

            <form asp-controller="Home" asp-action="StartCheckout" method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="campaignId" value="@Model.CampaignId" />
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <button type="submit" name="amountGbp" value="2" class="btn btn-outline-theme" data-cta="campaign-donate-2">£2</button>
                    <button type="submit" name="amountGbp" value="5" class="btn btn-outline-theme" data-cta="campaign-donate-5">£5</button>
                    <button type="submit" name="amountGbp" value="10" class="btn btn-theme" data-cta="campaign-donate-10">£10</button>
                    <button type="submit" name="amountGbp" value="25" class="btn btn-theme" data-cta="campaign-donate-25">£25</button>
                </div>
            </form>

            <form asp-controller="Home" asp-action="StartCheckout" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="campaignId" value="@Model.CampaignId" />
                <label for="customAmount" class="form-label">Custom amount (£)</label>
                <div class="input-group" style="max-width:280px;">
                    <input id="customAmount" type="number" step="0.01" min="1" name="amountGbp" class="form-control" required />
                    <button type="submit" class="btn btn-theme" data-cta="campaign-donate-custom">Donate</button>
                </div>
            </form>
        }

        <h5>Recent contributions</h5>
        @if (!Model.RecentContributions.Any())
        {
            <p class="text-muted">No contributions recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Amount</th>
                            <th>Source</th>
                            <th>Recorded (UTC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentContributions)
                        {
                            <tr>
                                <td>£@item.AmountGbp.ToString("0.00")</td>
                                <td>@item.Source</td>
                                <td>@item.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
