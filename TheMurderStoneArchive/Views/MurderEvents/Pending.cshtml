@model IEnumerable<TheMurderStoneArchive.Models.MurderEvent>

<div class="container mt-4">
    <h2>Pending Submissions Moderation Queue</h2>
    <p>
        <a asp-action="PendingSuggestions" class="btn btn-outline-primary btn-sm">View Pending Edit Suggestions &rarr;</a>
    </p>
    <p>
        <a asp-action="PendingSuggestions" class="btn btn-outline-primary btn-sm">View Pending Edit Suggestions &rarr;</a>
    </p>
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Submitted Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Category</td>
                    <td>@item.Location?.Name</td>
                    <td>
                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success" aria-label="Approve">✓</button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" aria-label="Edit">✏️</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" aria-label="Reject">✕</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>