@model IEnumerable<TheMurderStoneArchive.Models.MurderEvent>
@using System.Text.Json
@using System.Text.Json.Serialization

@{
    ViewData["Title"] = "Murder Stone Archive";

    var options = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        ReferenceHandler = ReferenceHandler.IgnoreCycles
    };
    var jsonModel = JsonSerializer.Serialize(Model, options);
}

<div>
    <div class="mb-3">
        <h1 class="page-title">The Murder Stone Archive</h1>
        <p class="lead">A free, publicly curated catalogue of markers, legends, and boundary stones — drawn from historical records and field reports.</p>
        <div class="mt-2">
            <a class="me-3 me-3 btn btn-primary btn-sm text-white" asp-controller="MurderEvents" asp-action="Index">Browse archive</a>
            <a class="btn btn-outline-theme btn-sm" asp-controller="MurderEvents" asp-action="Submit">Suggest an entry</a>
        </div>
    </div>
</div>

<!-- Category Filter UI -->
<div class="mb-3 d-flex justify-content-center align-items-center gap-2">
    <label for="categoryFilter" class="fw-bold">Filter Category:</label>
    <select id="categoryFilter" class="form-select w-auto" onchange="filterMarkers(this.value)">
        <option value="all">All Categories</option>
        <option value="0">Confirmed Murder Stone</option>
        <option value="1">Folkloric / Legend</option>
        <option value="2">Pudding Stone</option>
        <option value="3">Boundary Marker</option>
    </select>
</div>

<!-- Map Container -->
<div id="archiveMap" class="map-container"></div>

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<!-- Leaflet.markercluster — groups nearby pins into a single count bubble -->
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

<style>
    /* Coloured pin icons used in place of plain circle markers */
    .map-pin {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,.45);
    }
</style>

<script>
    // 1. Clean up existing map instance if reloading in DOM to prevent re-init errors
    if (window.myArchiveMap) {
        window.myArchiveMap.remove();
        window.myArchiveMap = null;
    }

    // 2. Initialize the Leaflet map instance
    // Center over the UK to show the whole island (approximate centre and zoom)
    const map = L.map('archiveMap').setView([54.0, -2.0], 5);
    window.myArchiveMap = map;

    // Add OpenStreetMap tile layer
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    // 3. Receive the serialized database records from C# (emit as a JS object literal)
    const murderEvents = @Html.Raw(jsonModel);

    // Category metadata — colour and display name keyed by enum int value
    const CATEGORY_META = {
        0: { color: '#dc3545', name: 'Confirmed Murder Stone'  },
        1: { color: '#ffc107', name: 'Folkloric / Legend'       },
        2: { color: '#6c757d', name: 'Pudding Stone'            },
        3: { color: '#198754', name: 'Boundary Marker'          }
    };

    // 4. One MarkerClusterGroup per category so the filter can add/remove whole groups
    const clusterGroups = {};
    Object.keys(CATEGORY_META).forEach(cat => {
        clusterGroups[cat] = L.markerClusterGroup({ chunkedLoading: true });
        map.addLayer(clusterGroups[cat]);
    });

    // Helper — build a coloured DivIcon that keeps the category colour coding
    function makePinIcon(color) {
        return L.divIcon({
            className: '',
            html: `<div class="map-pin" style="background:${color};"></div>`,
            iconSize:   [14, 14],
            iconAnchor: [7,  7],
            popupAnchor:[0, -10]
        });
    }

    // 5. Loop through database events and place markers into their cluster group
    murderEvents.forEach(item => {
        if (item.location && item.location.latitude && item.location.longitude) {
            const meta   = CATEGORY_META[item.category] ?? { color: '#0d6efd', name: 'Unknown' };
            const marker = L.marker(
                [item.location.latitude, item.location.longitude],
                { icon: makePinIcon(meta.color) }
            );

            marker.bindPopup(`
                <div>
                    <h5>${item.title}</h5>
                    <p class="m-0"><strong>Year:</strong> ${item.year}</p>
                    <p class="m-0"><strong>Location:</strong> ${item.location.name || 'N/A'}</p>
                    <p class="m-0 text-muted"><em>Category: ${meta.name}</em></p>
                    <a class="btn btn-primary btn-sm mt-2 text-white w-100" href="/MurderEvents/Details/${item.id}">More Info</a>
                </div>
            `);

            const groupKey = item.category.toString();
            if (clusterGroups[groupKey]) {
                clusterGroups[groupKey].addLayer(marker);
            }
        }
    });

    // 6. Filter — show only the selected category's cluster group (or all)
    function filterMarkers(selectedCategory) {
        Object.keys(clusterGroups).forEach(cat => {
            const group = clusterGroups[cat];
            if (selectedCategory === 'all' || cat === selectedCategory) {
                if (!map.hasLayer(group)) map.addLayer(group);
            } else {
                if (map.hasLayer(group))  map.removeLayer(group);
            }
        });
    }
</script>

<script data-goatcounter="https://themurderstonearchive.goatcounter.com/count"
    async src="~/js/count.js"></script>