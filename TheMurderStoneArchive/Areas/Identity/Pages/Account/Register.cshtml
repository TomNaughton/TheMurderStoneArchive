@page
@model TheMurderStoneArchive.Areas.Identity.Pages.Account.RegisterModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Register";
}

<div class="auth-container">
    <div class="auth-card">
        <h2 class="mb-3">Create an account</h2>
        <p class="muted">Register to submit stones and track your contributions.</p>

        <form id="registerForm" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            @if (TempData["DebugErrors"] != null)
            {
                <div class="alert alert-danger mt-2" role="alert">
                    <strong>Registration debug:</strong>
                    <pre>@TempData["DebugErrors"]</pre>
                </div>
            }
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.PublicUsername" class="form-label">Public username</label>
                <input asp-for="Input.PublicUsername" class="form-control" type="text" autocomplete="username" />
                <div class="form-text">Shown publicly on your comments and contributions. Not your email.</div>
                <span asp-validation-for="Input.PublicUsername" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response" />
            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-page="/Account/Login">Already have an account? Sign in</a>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="https://www.google.com/recaptcha/api.js?render=@Configuration["ReCaptcha:SiteKey"]" async defer></script>
    <script>
        (function(){
            var form = document.getElementById('registerForm');
            if (!form) return;
            form.addEventListener('submit', function(e){
                e.preventDefault();
                grecaptcha.ready(function(){
                    grecaptcha.execute('@Configuration["ReCaptcha:SiteKey"]', {action: 'register'}).then(function(token){
                        var el = document.getElementById('g-recaptcha-response');
                        if (!el) {
                            el = document.createElement('input'); el.type = 'hidden'; el.name = 'g-recaptcha-response'; el.id = 'g-recaptcha-response'; form.appendChild(el);
                        }
                        el.value = token;
                        form.submit();
                    });
                });
            });
        })();
    </script>
}
