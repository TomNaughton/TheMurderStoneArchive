<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TheMurderStoneArchive</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Merriweather:wght@300;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheMurderStoneArchive.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="The Murder Stone Archive" style="height:32px;margin-right:10px;" />
                    <span class="ms-2">Murder Stone Archive</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @* <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li> *@
                    </ul>

                    <form class="d-flex my-2 my-lg-0" role="search" asp-controller="Search" asp-action="Index" method="get">
                        <label for="q" class="visually-hidden">Search</label>
                        <input id="q" name="q" class="form-control form-control-sm me-2" type="search" placeholder="Search archive" aria-label="Search the archive" />
                        <button class="btn btn-outline-secondary btn-sm" type="submit">Search</button>
                    </form>

                    <ul class="navbar-nav ms-3 d-flex align-items-center">
                        <li class="nav-item me-2">
                            <a class="btn btn-submit btn-sm d-flex align-items-center text-white" asp-controller="MurderEvents" asp-action="Submit" role="button" aria-label="Submit a stone">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" width="16" height="16" class="me-2" focusable="false">
                                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span>Submit Stone</span>
                            </a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item me-2"><a class="btn btn-outline-light btn-sm" asp-controller="MurderEvents" asp-action="Pending">Pending</a></li>
                            <li class="nav-item me-2"><a class="btn btn-outline-light btn-sm" asp-controller="MurderEvents" asp-action="Index">Admin</a></li>
                        }

                        <li class="nav-item">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer bg-dark text-light py-4 mt-5">
        <div class="container text-center small">
            &copy; 2026 - Murder Stone Archive &middot; <a class="text-decoration-underline text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
