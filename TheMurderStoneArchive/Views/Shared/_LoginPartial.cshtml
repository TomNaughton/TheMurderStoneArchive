@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@* Desktop / larger screens: keep account dropdown *@
<li class="nav-item dropdown d-none d-md-block">
    <a class="nav-link dropdown-toggle text-dark d-flex align-items-center" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="me-1">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="visually-hidden">My Account</span>
    </a>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
        @if (SignInManager.IsSignedIn(User))
        {
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Manage Account</a>
            </li>
            <li>
                <form class="dropdown-item p-0 m-0" asp-area="Identity" asp-page="/Account/Logout" method="post" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="btn btn-link dropdown-item text-start">Logout</button>
                </form>
            </li>
        }
        else
        {
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">Register</a>
            </li>
            <li>
                <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login">Login</a>
            </li>
        }
    </ul>
</li>

@* Mobile / small screens: show account links directly in the collapsed menu so they are not nested under an extra dropdown *@
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item d-md-none">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">Manage Account</a>
    </li>
    <li class="nav-item d-md-none">
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item d-md-none">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item d-md-none">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
