<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="~/images/logo.svg" />
    <title>@ViewData["Title"] - The Murder Stone Archive</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Merriweather:wght@300;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheMurderStoneArchive.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm modern-navbar mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="The Murder Stone Archive" class="site-logo" />
                    <span class="site-title">The Murder Stone Archive</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @* <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li> *@
                    </ul>

                        <form class="d-flex my-2 my-lg-0" role="search" asp-controller="MurderEvents" asp-action="Index" method="get">
                        <label for="searchTerm" class="visually-hidden">Search</label>
                        <input id="searchTerm" name="searchTerm" class="form-control form-control-sm me-2" type="search" placeholder="Search archive" aria-label="Search the archive" />
                        <button class="btn btn-outline-theme btn-sm" type="submit">Search</button>
                    </form>

                    <ul class="navbar-nav ms-3 d-flex align-items-center">
                        <li class="nav-item me-2">
                            <a class="btn btn-submit btn-sm d-flex align-items-center text-white" asp-controller="MurderEvents" asp-action="Submit" role="button" aria-label="Submit a stone">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true" width="16" height="16" class="me-2" focusable="false">
                                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <span>Submit</span>
                            </a>
                        </li>

                        <li class="nav-item me-2">
                            <a class="btn btn-theme btn-sm" asp-controller="Home" asp-action="Campaign" data-cta="nav-campaign">Campaign</a>
                        </li>
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-theme btn-sm" asp-controller="Home" asp-action="ResearchPack" data-cta="nav-researchpack">Research Pack</a>
                        </li>

                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <li class="nav-item me-2"><a class="btn btn-outline-theme btn-sm" asp-controller="Home" asp-action="Analytics">Analytics</a></li>
                            <li class="nav-item me-2"><a class="btn btn-outline-theme btn-sm" asp-controller="MurderEvents" asp-action="Pending">Pending</a></li>
                        }

                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer bg-dark text-light py-4 mt-5">
        <div class="container text-center small d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 gap-md-0">
            <div class="d-flex flex-column flex-md-row gap-3 w-100 w-md-auto justify-content-md-start">
                <a asp-controller="Home" asp-action="Campaign" class="text-light" data-cta="footer-campaign">Support the Archive</a>
                <a asp-controller="Home" asp-action="ResearchPack" class="text-light" data-cta="footer-researchpack">Research Pack</a>
                <a asp-controller="Home" asp-action="Funding" class="text-light" data-cta="footer-funding">Funding</a>
                <a asp-controller="Home" asp-action="Privacy" class="text-light">Privacy</a>
                <a asp-controller="Home" asp-action="Terms" class="text-light">Terms</a>
                <a asp-controller="Home" asp-action="DMCA" class="text-light">DMCA</a>
            </div>
            <div>&copy; 2026 - The Murder Stone Archive</div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
