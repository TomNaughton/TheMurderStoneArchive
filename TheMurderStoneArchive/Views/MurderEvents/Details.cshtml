@using System.Security.Claims
@model TheMurderStoneArchive.Models.MurderEvent

@{
    var currentUserId = User.Identity?.IsAuthenticated == true ? User.FindFirstValue(ClaimTypes.NameIdentifier) : null;
}

<style>
    /* Gallery sizing: constrain carousel to viewport height and ensure media fits inside */
    .event-gallery .carousel-inner,
    #eventCarousel .carousel-inner {
        height: 60vh;
        max-height: 60vh;
    }
    /* Keep carousel-item default display to preserve Bootstrap transitions; center media inside a wrapper */
    .event-gallery .carousel-item,
    #eventCarousel .carousel-item {
        height: 100%;
    }
    .event-gallery .media-wrap,
    #eventCarousel .media-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        width: 100%;
    }
    .event-gallery .media-wrap img,
    #eventCarousel .media-wrap img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        display: block;
        margin: 0 auto;
    }
    .event-gallery .media-wrap .ratio,
    #eventCarousel .media-wrap .ratio {
        height: 100%;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .event-gallery .media-wrap .ratio iframe,
    #eventCarousel .media-wrap .ratio iframe {
        max-height: 100%;
        max-width: 100%;
    }

    @@media (max-width: 576px) {
        .event-gallery .carousel-inner,
        #eventCarousel .carousel-inner { height: 40vh; max-height: 40vh; }
    }

    /* Subtle gallery background and improved control visibility */
    .event-gallery {
        background-color: #fbfbfc; /* very light gray */
        padding: 0.5rem;
        border-radius: 0.5rem;
        box-shadow: 0 1px 4px rgba(16,24,40,0.04);
    }
    .event-gallery .carousel-indicators {
        bottom: 0.25rem;
    }
    .event-gallery .carousel-control-prev-icon,
    .event-gallery .carousel-control-next-icon {
        /* Use Bootstrap's secondary gray for better contrast */
        background-color: #6c757d;
        border-radius: 50%;
        width: 2.25rem;
        height: 2.25rem;
        background-size: 1.25rem 1.25rem;
        background-position: center;
        opacity: 0.95;
        box-shadow: 0 4px 10px rgba(0,0,0,0.25);
        transition: box-shadow .15s ease-in-out, transform .15s ease-in-out;
        transform: none;
    }
    .event-gallery .carousel-control-prev:hover .carousel-control-prev-icon,
    .event-gallery .carousel-control-next:hover .carousel-control-next-icon {
        box-shadow: 0 8px 18px rgba(0,0,0,0.32);
        transform: scale(1.06);
    }
    .event-gallery .carousel-control-prev,
    .event-gallery .carousel-control-next {
        width: 3rem;
    }
    /* On larger screens use a two-column layout provided by the Bootstrap grid
       instead of reserving space with a float-based margin. This keeps the
       gallery and infobox in separate columns so they won't overlap. */
    @@media (min-width: 768px) {
        .event-gallery { margin-right: 0; }
    }

    /* When rendering this page we place the infobox into its own Bootstrap column;
       ensure the global .infobox float doesn't cause overlap by overriding it here. */
    .infobox {
        float: none !important;
        margin: 0 0 1rem 0 !important;
        min-width: auto !important;
        max-width: 100% !important;
    }
</style>

<div class="container mt-4">
    <div class="row">
        <main class="col-md-8">
            <h2>@Model.Title</h2>
            <p class="text-muted small">@Model.Year &middot; @Model.Location?.Name</p>

            <div class="mb-3">
                <h3>Description</h3>
                <p>@Model.Description</p>
            </div>

            @{
                var mediaItems = new List<object>(); // objects will be either MurderEventPhoto or MurderEventVideo
                if (Model.Photos != null) mediaItems.AddRange(Model.Photos.Cast<object>());
                if (Model.Videos != null) mediaItems.AddRange(Model.Videos.Cast<object>());
            }

            @if (mediaItems.Any())
            {
                <div class="mb-4">
                    <h3>Gallery</h3>
                    <div id="eventCarousel" class="carousel slide event-gallery" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            @for (int i = 0; i < mediaItems.Count; i++)
                            {
                                <button type="button" data-bs-target="#eventCarousel" data-bs-slide-to="@i" class="@(i==0?"active":"")" aria-current="@(i==0?"true":"false")" aria-label="Slide @(i+1)"></button>
                            }
                        </div>
                        <div class="carousel-inner">
                            @for (int i = 0; i < mediaItems.Count; i++)
                            {
                                var item = mediaItems[i];
                                <div class="carousel-item @(i==0?"active":"")">
                                    <div class="media-wrap">
                                    @if (item is TheMurderStoneArchive.Models.MurderEventPhoto p)
                                    {
                                        <img src="@Url.Action("Photo", "MurderEvents", new { id = p.Id })" class="d-block" alt="@p.FileName" />
                                        @if (!string.IsNullOrWhiteSpace(p.Attribution))
                                        {
                                            <div class="carousel-caption d-block text-start py-1 px-2" style="background:rgba(0,0,0,0.55);bottom:0;left:0;right:0;border-radius:0 0 0.25rem 0.25rem;">
                                                <small class="text-white" style="font-size:0.75rem;line-height:1.2">@p.Attribution</small>
                                            </div>
                                        }
                                    }
                                    else if (item is TheMurderStoneArchive.Models.MurderEventVideo v && !string.IsNullOrEmpty(v.VideoId))
                                    {
                                        <div class="ratio ratio-16x9">
                                            <iframe src="https://www.youtube.com/embed/@v.VideoId" title="YouTube video player" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                                        </div>
                                    }
                                    </div>
                                </div>
                            }
                        </div>
                        @if (mediaItems.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="fact">
                <strong>Note:</strong> Entries are drawn from historical records and community submissions. Where possible, sources are indicated on each page.
            </div>

            @if (User.IsInRole("Admin") || (!string.IsNullOrEmpty(Model.CreatedById) && Model.CreatedById == currentUserId))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-warning mb-3">Edit</a>
            }
            @if (User.IsInRole("Admin") || (!string.IsNullOrEmpty(Model.CreatedById) && Model.CreatedById == currentUserId))
            {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger mb-3">Delete</a>
            }
            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && Model.CreatedById != currentUserId)
            {
                <a asp-action="SuggestEdit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary mb-3">Suggest an edit</a>
            }
            <a asp-action="ChangeLog" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary mb-3">View changelog</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm mb-3">Back to List</a>

            @{
                var contributorIds = new List<string>();
                if (!string.IsNullOrEmpty(Model.CreatedById)) contributorIds.Add(Model.CreatedById);
                if (Model.ChangeLogEntries != null)
                {
                    foreach (var c in Model.ChangeLogEntries)
                    {
                        if (!contributorIds.Contains(c.ContributorId)) contributorIds.Add(c.ContributorId);
                    }
                }
            }
            @if (contributorIds.Any())
            {
                <div class="fact mb-3">
                    <strong>Contributors:</strong>
                    @string.Join(", ", contributorIds.Select(id => (Model.CreatedById == id ? Model.CreatedBy?.PublicUsername : Model.ChangeLogEntries.FirstOrDefault(c => c.ContributorId == id)?.Contributor?.PublicUsername) ?? "Unknown"))
                </div>
            }

            <div class="mb-4">
                <h3>Comments</h3>
                @if (TempData["CommentError"] != null)
                {
                    <div class="alert alert-danger">@TempData["CommentError"]</div>
                }
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    <ul class="list-group mb-3">
                        @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedUtc))
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <strong>@(comment.User?.PublicUsername ?? "Unknown")</strong>
                                    <small class="text-muted">@comment.CreatedUtc.ToString("g")</small>
                                </div>
                                <p class="mb-0">@comment.Content</p>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No comments yet.</p>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="AddComment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="murderEventId" value="@Model.Id" />
                        <div class="mb-2">
                            <textarea name="content" class="form-control" rows="3" placeholder="Add a comment..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Post comment</button>
                    </form>
                }
                else
                {
                    <p><a asp-area="Identity" asp-page="/Account/Login">Sign in</a> to add a comment.</p>
                }
            </div>
        </main>

        <aside class="col-md-4">
            @await Html.PartialAsync("_Infobox", Model)
        </aside>
    </div>
</div>
